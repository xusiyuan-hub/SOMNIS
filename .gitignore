# ============================================================================
# SOMNIS — research repository ignore rules
# IMPORTANT: Treat real PSG, patient identifiers, feature matrices and predictions
# as confidential. .gitignore only prevents *new untracked* files from being
# staged by ordinary 'git add'; it DOES NOT untrack or erase prior commits.
# ============================================================================

# --- Private raw/derived data and study outputs, regardless of location ---
data/
dataset/
datasets/
raw/
processed/
preprocessed/
derived/
sleepstage/
labels/
splits/
results/
outputs/
output/
artifacts/
checkpoints/
logs/
cache/

# --- PSG/EEG recordings and signal data ---
*.set
*.fdt
*.edf
*.bdf
*.fif
*.fif.gz
*.vhdr
*.vmrk
*.eeg
*.cnt
*.mff
*.mat
*.h5
*.hdf5
*.hdf

# --- Per-participant matrices, arrays, serialized models and tables ---
*.npz
*.npy
*.pkl
*.pickle
*.joblib
*.parquet
*.feather
*.arrow
*.xlsx
*.xls
*.sav
*.nwb

# --- Conservative policy: no local result tables / GSSC staging CSVs by default ---
# Explicitly review and whitelist synthetic/approved aggregate tables if needed.
*.csv
*.tsv
*.csv.gz
*.tsv.gz

# --- Restricted train/test subject lists (even when outside data/labels/) ---
earlyMSA_train.txt
earlyMSA_test.txt
earlyPD_train.txt
earlyPD_test.txt
MSA.txt
PD.txt
earlyMSA.txt
earlyPD.txt
*train_ids*.txt
*test_ids*.txt
*id_list*.txt
*subject*list*.txt
*subject_ids*.txt
*subject-id*.txt
*patient_ids*.txt
*participant_ids*.txt
*subject_ids*.csv
*patient_ids*.csv
*participant_ids*.csv

# --- Locally generated numerical figures / exported predictions ---
*_predictions*.json
*_probabilities*.json
*performance_summary*.json
*_SUCCESS.json

# --- Conda / Python virtual environments and notebooks ---
.env
.env.*
!.env.example
.venv/
venv/
env/
ENV/
.conda/
conda-meta/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# --- Local IDE/OS metadata ---
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- Logs, crash reports and temporary files ---
*.log
*.tmp
*.temp
*.bak
*.old
*.partial
*.partial.*
*.crdownload

# --- Local credentials, keys and other secrets ---
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
secrets.json

# Keep tracked research source and environment specs:
# *.py, *.md, *.yml, *.yaml, ordinary .txt documentation, .gitignore
# remain eligible for Git commits unless matched by a rule above.
